# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://tipsdeck:change-me@localhost:5432/tipsdeck?schema=public"

# Public canonical URL. Update this in each deployed environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_TELEGRAM_URL="https://t.me/your-channel"
NEXT_PUBLIC_WHATSAPP_URL="https://whatsapp.com/channel/your-channel-id"

# Runtime environment label used in logs and diagnostics.
APP_ENV="development"
CRON_SECRET="replace-with-a-long-random-secret"
# Paystack hosted checkout and webhook verification. Use sk_test_... locally.
PAYSTACK_SECRET_KEY=""

# Booking-code importer. Defaults to the owner's existing A1 Tips loader.
SPORTYBET_LOADER_BASE_URL="https://a1-tips-backend-v2.onrender.com"

# Optional: creates or promotes a super-admin when `npm run db:seed` runs.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_USERNAME="tipsdeck-admin"
SEED_ADMIN_PASSWORD=""
